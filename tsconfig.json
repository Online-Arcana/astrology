{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023", "DOM"],
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noImplicitReturns": true, "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true, "verbatimModuleSyntax": true, "skipLibCheck": false, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
