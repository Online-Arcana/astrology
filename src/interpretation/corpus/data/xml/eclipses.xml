      </source-refs>
      <neutrality religious="false" spiritual="false" karmic="false" fatalistic="false" supernatural="false" />
    </claim>
    <claim id="derived.eclipses-at-birth.detail.types" atom-id="derived.eclipses-at-birth" category="interaction" confidence="core">
      <proposition>A solar eclipse is a New-Moon conjunction near the lunar nodal axis, while a lunar eclipse is a Full-Moon opposition near that axis; the type is calculation evidence rather than a prediction of what must happen to the person.</proposition>
      <tags>
        <tag>solar eclipse</tag>
        <tag>lunar eclipse</tag>
        <tag>New Moon</tag>
        <tag>Full Moon</tag>
        <tag>nodal axis</tag>
      </tags>
