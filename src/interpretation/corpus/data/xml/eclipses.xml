    <claim id="derived.eclipses-at-birth.core.context" atom-id="derived.eclipses-at-birth" category="core" confidence="school-specific">
      <proposition>An eclipse coinciding with birth can be treated as additional context around the natal Sun-Moon-node configuration and any chart factors closely connected with the eclipse degree.</proposition>
      <tags>
        <tag>eclipse at birth</tag>
        <tag>natal context</tag>
        <tag>Sun-Moon-node configuration</tag>
        <tag>contacted chart factors</tag>
      </tags>
      <source-refs>
