      <neutrality religious="false" spiritual="false" karmic="false" fatalistic="false" supernatural="false" />
    </claim>
    <claim id="pattern.kite.core.structure" atom-id="pattern.kite" category="interaction" confidence="school-specific">
      <proposition>A Kite adds an opposition and two sextiles to a Grand Trine, introducing tension and a focal direction that can help mobilise capacities that might otherwise remain comfortable but inactive.</proposition>
      <tags>
        <tag>mobilisation</tag>
