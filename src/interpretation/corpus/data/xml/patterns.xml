      </source-refs>
      <neutrality religious="false" spiritual="false" karmic="false" fatalistic="false" supernatural="false" />
    </claim>
    <claim id="pattern.grand-cross.core.structure" atom-id="pattern.grand-cross" category="interaction" confidence="school-specific">
      <proposition>A Grand Cross combines multiple squares and oppositions into a stable but demanding configuration, concentrating several competing pressures that require sustained effort and adjustment.</proposition>
      <tags>
        <tag>competing pressures</tag>
        <tag>stability</tag>
        <tag>inflexibility</tag>
        <tag>effort</tag>
        <tag>adjustment</tag>
      </tags>
      <source-refs>
