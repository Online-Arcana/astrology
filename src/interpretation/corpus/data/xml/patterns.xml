    </claim>
    <claim id="pattern.yod.core.structure" atom-id="pattern.yod" category="interaction" confidence="school-specific">
      <proposition>A Yod combines two quincunxes with a sextile, placing subtle adjustment pressure on the focal planet while the sextile provides a potentially constructive exchange between the other two principles.</proposition>
      <tags>
        <tag>adjustment</tag>
        <tag>subtle tension</tag>
        <tag>focal point</tag>
        <tag>constructive exchange</tag>
      </tags>
